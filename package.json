{
  "name": "@alephscript/mcp-core-sdk",
  "version": "1.5.0",
  "description": "AlephScript Core SDK - Types and utilities for MCP ecosystem (unified from mcp-channels-sdk)",
  "author": {
    "name": "AlephScript Ops",
    "email": "ops@escrivivir.co",
    "url": "https://escrivivir.co"
  },
  "maintainers": [
    {
      "name": "AlephScript Ops",
      "email": "ops@escrivivir.co",
      "url": "https://escrivivir.co"
    }
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vector-db": {
      "types": "./dist/vector-db/index.d.ts",
      "default": "./dist/vector-db/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types/browser": {
      "types": "./dist/types/browser/index.d.ts",
      "default": "./dist/types/browser/index.js"
    },
    "./types/prolog": {
      "types": "./dist/types/prolog/index.d.ts",
      "default": "./dist/types/prolog/index.js"
    },
    "./types/mcp": {
      "types": "./dist/types/mcp.d.ts",
      "default": "./dist/types/mcp.js"
    },
    "./types/typed-prompts": {
      "types": "./dist/types/typed-prompts/index.d.ts",
      "default": "./dist/types/typed-prompts/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./protocol": "./protocol/index.mjs",
    "./channels": "./channels/index.mjs",
    "./spec": "./spec/index.mjs",
    "./horse-transport": "./horse-transport/index.mjs"
  },
  "typesVersions": {
    "*": {
      "vector-db": [
        "dist/vector-db/index.d.ts"
      ],
      "browser": [
        "dist/browser/index.d.ts"
      ],
      "server": [
        "dist/server/index.d.ts"
      ],
      "client": [
        "dist/client/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "types/browser": [
        "dist/types/browser/index.d.ts"
      ],
      "types/prolog": [
        "dist/types/prolog/index.d.ts"
      ],
      "types/mcp": [
        "dist/types/mcp.d.ts"
      ],
      "types/typed-prompts": [
        "dist/types/typed-prompts/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "test:facade": "node --test test-facade/*.mjs"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@socket.io/admin-ui": "^0.5.1",
    "ajv": "^8.17.1",
    "chromadb": "^3.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "xstate": "^5.32.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "license": "AIPLv1"
}
